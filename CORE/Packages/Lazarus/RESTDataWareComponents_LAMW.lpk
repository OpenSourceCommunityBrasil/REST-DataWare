    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)" />
    </UsageOptions>
    <PublishOptions>
      <Version Value="2" />
    </PublishOptions>
  </Package>
</CONFIG>
