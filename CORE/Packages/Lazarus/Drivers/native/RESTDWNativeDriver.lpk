<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="RESTDWNativeDriver"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Gilberto Rocha da Silva"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\..\..\..\Source\Includes"/>
        <OtherUnitFiles Value="..\..\..\..\Source\Database_Drivers;..\..\..\..\Source\Basic;..\..\..\..\Source\Basic\ZLib"/>
        <UnitOutputDirectory Value="..\..\..\..\compiledlaz"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="REST Dataware Native Driver"/>
    <License Value="GPL- 3.0"/>
    <Version Major="2" Minor="1"/>
    <Files Count="3">
      <Item1>
        <Filename Value="RESTDWNativeDriver.pas"/>
        <UnitName Value="RESTDWNativeDriver"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\..\..\Source\Database_Drivers\uRESTDWNativeDriver.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uRESTDWNativeDriver"/>
      </Item2>
      <Item3>
        <Filename Value="uRESTDWNativeDriverRegLazarus.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uRESTDWNativeDriverRegLazarus"/>
