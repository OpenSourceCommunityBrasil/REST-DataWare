Package RESTDWDBExpressPhysDriver;

{$R *.res}
{$R 'RESTDWDBExpressPhysDriver.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'REST Dataware - DBExpress Phys Driver'}
{$IMPLICITBUILD ON}

Requires
 RESTDWCore,
 dbexpress;

Contains
 uRESTDWDBExpressPhysDriver In '..\..\..\..\Source\Database_Drivers\uRESTDWDBExpressPhysDriver.pas',
 uRESTDWDBExpressPhysLink In '..\..\..\..\Source\Database_Drivers\DBExpressPhysLink\uRESTDWDBExpressPhysLink.pas';
End.
