Function RESTDWLoadHTMLDesignerBitmapData(
 ABitmap : TBitmap;
 Const AData;
 ASize : Integer) : Boolean;
Var
 LStream : TMemoryStream;
Begin
 Result := False;
 If Not Assigned(ABitmap) Then
  Exit;
 LStream := TMemoryStream.Create;
 Try
  LStream.WriteBuffer(AData,ASize);
  LStream.Position := 0;
  ABitmap.LoadFromStream(LStream);
  Result := True;
 Except
  Result := False;
 End;
 LStream.Free;
End;
Function RESTDWLoadHTMLDesignerTwoStateBitmap(
 ABitmap : TBitmap;
 Const AData;
 ASize : Integer) : Boolean;
Var
 LSource : TBitmap;
 LStream : TMemoryStream;
Begin
 Result := False;
 If Not Assigned(ABitmap) Then
  Exit;
 LSource := TBitmap.Create;
 LStream := TMemoryStream.Create;
 Try
  Try
   LStream.WriteBuffer(AData,ASize);
   LStream.Position := 0;
   LSource.LoadFromStream(LStream);
   ABitmap.Width := LSource.Width * 2;
   ABitmap.Height := LSource.Height;
   ABitmap.Canvas.Draw(0,0,LSource);
   ABitmap.Canvas.Draw(LSource.Width,0,LSource);
   Result := True;
  Except
   Result := False;
  End;
 Finally
  LStream.Free;
  LSource.Free;
 End;
End;
Function RESTDWLoadHTMLDesignerSaveIcon(
 ABitmap : TBitmap) : Boolean;
Begin
 Result :=
  RESTDWLoadHTMLDesignerTwoStateBitmap(
   ABitmap,
   CToolbarSaveIconData[0],
   SizeOf(CToolbarSaveIconData)
  );
End;
